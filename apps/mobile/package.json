{
  "name": "@rj/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "android:sync": "pnpm build && cap sync android",
    "android:apk": "node ../../scripts/mobile/check-android.mjs && pnpm android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/network": "^8.0.0",
    "@supabase/supabase-js": "^2.107.0",
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^1.1.7",
    "lucide-react": "^1.16.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@electric-sql/pglite": "^0.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.9.6",
    "typescript": "5.7.3",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
